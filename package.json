{
  "name": "my-dream-mental",
  "private": true,
  "version": "1.0.0",
  "description": "MY DREAM MENTAL — mental arifmetika platformasi (Teacher + Student, Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:db": "wrangler d1 migrations apply my-dream-mental-db --remote",
    "db:create": "wrangler d1 create my-dream-mental-db",
    "db:migrate": "wrangler d1 migrations apply my-dream-mental-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply my-dream-mental-db --remote",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@cloudflare/workers-types": "^5.20250919.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
