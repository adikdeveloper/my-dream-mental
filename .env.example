# Copy to .env (local only, NEVER commit .env)
# Teacher bootstrap (used by scripts/seed.mjs)
TEACHER_USERNAME=teacher
TEACHER_EMAIL=teacher@mydream.uz
TEACHER_PASSWORD=ChangeMe123!

# D1 local id (after `npx wrangler d1 create my-dream-mental-db`, paste id into wrangler.jsonc)
D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_ID

# Session secret (min 32 chars) — used to sign session cookies (HMAC)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# App timezone
APP_TIMEZONE=Asia/Tashkent
